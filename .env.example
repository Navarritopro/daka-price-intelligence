# Compartida por Vercel y GitHub Actions
DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# Solo Vercel: permite disparar el workflow manual
ADMIN_API_KEY=cambie-esta-clave-larga
GITHUB_OWNER=organizacion-o-usuario
GITHUB_REPO=daka-price-intelligence
GITHUB_WORKFLOW_FILE=scrape.yml
GITHUB_TOKEN=github_pat_con_permiso_actions_write

# Solo GitHub Actions: alertas
ALERT_THRESHOLD_PERCENT=5
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Ajustes opcionales del scraper
SCRAPER_MAX_PAGES=200
SCRAPER_EMPTY_PAGE_LIMIT=3
SCRAPER_DELAY_SECONDS=0.8
SCRAPER_PAGE_TIMEOUT_MS=60000

# Ajustes opcionales de IVOO (el endpoint predeterminado ya está configurado)
IVOO_PAGE_SIZE=50
IVOO_MAX_PAGES=200
IVOO_DELAY_SECONDS=0.20
IVOO_TIMEOUT_SECONDS=60

# Ajustes opcionales de Venelectronics (el endpoint predeterminado ya está configurado)
VENELECTRONICS_PAGE_SIZE=100
VENELECTRONICS_MAX_PAGES=100
VENELECTRONICS_DELAY_SECONDS=10
VENELECTRONICS_TIMEOUT_SECONDS=60
VENELECTRONICS_RETRY_ATTEMPTS=3
VENELECTRONICS_CHALLENGE_BASE_SECONDS=20

# Reintentos ante fallos transitorios de la API pública de Damasco
DAMASCO_RETRY_ATTEMPTS=3
DAMASCO_RETRY_BASE_SECONDS=3
